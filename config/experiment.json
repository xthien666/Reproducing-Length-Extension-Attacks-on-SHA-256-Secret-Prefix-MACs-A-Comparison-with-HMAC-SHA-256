        "sanity_checks": 640,
        "attacker_continuation_calls": 8192,
        "attacker_compression_blocks": 12288
      }
    },
    "main": {
      "repetitions_per_combination": 10,
      "expected_counts": {
        "base_cases": 640,
        "case_scheme_pairs": 1280,
        "candidate_attempts": 81920,
        "sanity_checks": 6400,
        "attacker_continuation_calls": 81920,
        "attacker_compression_blocks": 122880
      }
    }
  },
  "sanity_checks": [
    {"id": "original", "expected_accept": true},
    {"id": "message_bit_flip", "expected_accept": false},
    {"id": "tag_bit_flip", "expected_accept": false},
    {"id": "append_keep_tag", "expected_accept": false},
    {"id": "short_tag", "expected_accept": false}
